+def reset_kv_scales_for_unquantized_cache(model: torch.nn.Module) -> int:
+    """Neutralize checkpoint KV scales when the KV cache is not quantized.
+
+    ``BaseKVCacheMethod`` loads per-tensor FP8 KV scales before the KV cache
+    dtype is resolved. They describe a cache stored as ``k / k_scale``; an
+    unquantized (bf16/fp16/fp32) cache stores ``k`` as is, but attention
+    backends still multiply by ``k_scale_float``/``v_scale_float``. Reset them
+    to 1.0 so unquantized caches read back what was written. Returns the number
+    of attention layers changed.
+    """
+    changed = 0
+    for module in model.modules():
+        k_float = getattr(module, "k_scale_float", None)
+        v_float = getattr(module, "v_scale_float", None)
+        if k_float in (None, 1.0) and v_float in (None, 1.0):
+            continue
+        module.k_scale_float = 1.0
+        module.v_scale_float = 1.0
+        for name in ("k_scale", "v_scale"):
+            scale = getattr(module, name, None)
+            if isinstance(scale, torch.Tensor):
+                with torch.no_grad():
+                    scale.fill_(1.0)
+        changed += 1
+    if changed:
+        logger.info(
+            "KV cache is unquantized: ignoring checkpoint KV scales on %d layers.",
+            changed,
+        )
+    return changed
