From e63458fabc8b1dbe1fcf37fc487cdebbbf2ddeba Mon Sep 17 00:00:00 2001
From: numinousmuses <103385201+numinousmuses@users.noreply.github.com>
Date: Mon, 21 Sep 2026 21:45:42 +0000
Subject: [PATCH] scheduler: make --num-continuous-decode-steps real. After a
 prefill batch, decode runs up to N steps before the next prefill is admitted
 while requests are running (pure rule in managers/decode_burst.py, tests in
 test/numinous). Short-turn agent traffic otherwise stalls decode behind every
 turn's prefill (K2.7 15 tok/s per user at 200-token turns vs 67 at long
 outputs).

---
 python/sglang/srt/managers/decode_burst.py | 30 ++++++++++++++++++++
 python/sglang/srt/managers/scheduler.py    | 16 +++++++++++
 test/numinous/test_decode_burst.py         | 33 ++++++++++++++++++++++
 3 files changed, 79 insertions(+)
 create mode 100644 python/sglang/srt/managers/decode_burst.py
 create mode 100644 test/numinous/test_decode_burst.py

diff --git a/python/sglang/srt/managers/decode_burst.py b/python/sglang/srt/managers/decode_burst.py
new file mode 100644
index 000000000..d6e9b24aa
--- /dev/null
+++ b/python/sglang/srt/managers/decode_burst.py
@@ -0,0 +1,30 @@
+"""Numinous: decode-burst admission rule behind --num-continuous-decode-steps.
+
+Pure so it can be unit-tested without the scheduler's GPU dependencies.
+"""
+
+
+def hold_prefill(
+    burst: int,
+    streak: int,
+    last_batch_was_extend: bool | None,
+    running_nonempty: bool,
+    running_prefill_only: bool,
+) -> bool:
+    """True when this scheduler pass should skip prefill admission and let decode take the step.
+
+    burst <= 1 disables the rule. The hold applies only after a non-extend (decode) pass, while fewer than
+    `burst` consecutive decode steps have run, and only when there are running decode requests; an idle
+    scheduler admits prefill immediately so first-token latency on an idle node is unchanged.
+    """
+    if burst <= 1 or last_batch_was_extend is None or last_batch_was_extend:
+        return False
+    if not running_nonempty or running_prefill_only:
+        return False
+    return streak < burst
+
+
+def next_streak(burst: int, streak: int, prefill_admitted: bool) -> int:
+    if burst <= 1:
+        return 0
+    return 0 if prefill_admitted else streak + 1
