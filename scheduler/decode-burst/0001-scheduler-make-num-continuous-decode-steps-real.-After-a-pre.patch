+        # Numinous: --num-continuous-decode-steps. After a prefill batch, let decode run up to this many
+        # steps before the next prefill batch is admitted, while requests are running. Bounds how often
+        # short-turn agent traffic stalls decode behind prefill; idle prefill latency is unchanged.
+        self.decode_burst = max(1, int(get_schedule().num_continuous_decode_steps or 1))
+        self.decode_streak = 0
