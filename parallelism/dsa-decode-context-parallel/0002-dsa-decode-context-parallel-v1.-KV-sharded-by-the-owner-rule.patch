                     )
@@ -2271,6 +2275,26 @@ class DeepseekSparseAttnBackend(
                 page_size=1,
             )
 
+        if get_parallel().dcp_enabled:
+            # Numinous DCP: the selected slots are virtual; keep the ones this rank owns as local rows, the rest
+            # become -1. FlashMLA's fp8 decode kernel masks -1, takes the per-row valid count as cache_seqlens and
+            # returns the rank-local (o, lse) the cross-rank merge consumes (base e).
+            from sglang.srt.layers.attention.dsa.dcp_topk import owned_local_slots
+            page_table_1, local_counts = owned_local_slots(
+                page_table_1, get_parallel().attn_dcp_size, get_parallel().attn_dcp_rank
+            )
+            if q_rope is not None:
+                q_all = concat_mla_absorb_q_general(q_nope, q_rope)
