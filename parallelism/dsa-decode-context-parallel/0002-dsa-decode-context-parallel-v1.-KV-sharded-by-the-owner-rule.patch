     def _build_oot_dsa_kv_pool(self, *, max_total_num_tokens: int) -> KVCache:
         PoolCls = current_platform.get_dsa_kv_pool_cls()
+        # Numinous DCP on the DSA pool. The latent KV is sharded by the owner rule (the MLA write kernels
+        # divide the allocator's virtual slot by the world size), so the pool keeps max_total rows per rank.
+        # The indexer key cache stays replicated and is addressed by the virtual slot directly, so it spans
+        # max_total x dcp rows. The replicated draft pool keeps 64-token index pages (the paged MQA kernels
+        # need them) over its virtual-slot span, which its 64 x dcp allocator paging is a multiple of.
+        dcp_size = get_parallel().attn_dcp_size
+        dsa_page_size = self.pool_page_size
+        dsa_size = max_total_num_tokens
+        if dcp_size > 1:
+            dsa_page_size = get_schedule().page_size
+            if self.is_draft_worker:
+                dsa_size = max_total_num_tokens + self.pool_page_size
+            else:
+                pool_kwargs["index_buf_size"] = max_total_num_tokens * dcp_size
         token_to_kv_pool = PoolCls(
-            max_total_num_tokens,
