+                kv_cache=kv_cache,
+                v_head_dim=layer.v_head_dim,
+                sm_scale=layer.scaling,
+                layer=layer,
+                page_table_1=page_table_1,
+                cache_seqlens=local_counts,
+            )
+
         if self.dsa_decode_impl == "flashmla_sparse":
             if q_rope is not None:
                 q_all = concat_mla_absorb_q_general(q_nope, q_rope)
@@ -2852,6 +2876,87 @@ class DeepseekSparseAttnBackend(
 
         return o
 
+    def _gather_dcp_prefix_kv(self, forward_batch: ForwardBatch, layer, k: torch.Tensor, k_rope: torch.Tensor) -> torch.Tensor:
+        """Numinous DCP extend: bf16 latent KV for the batch as [sum_r (prefix_r + extend_r), 1, dim], each request
+        contiguous with its prefix first, from the group-gathered prefixes and this pass's new tokens."""
+        from sglang.srt.layers.dcp.comm import all_gather_kv_cache_for_dcp
+
+        meta = forward_batch.attn_dcp_metadata
+        prefix_lens = list(forward_batch.extend_prefix_lens_cpu)
+        extend_lens = list(forward_batch.extend_seq_lens_cpu)
+        kv_layer = self.token_to_kv_pool.get_key_buffer(layer.layer_id)
+        local_idx = meta.dcp_local_prefix_kv_indices
+        if self.dsa_kv_cache_store_fp8:
+            rows = dequantize_k_cache_paged(kv_layer, local_idx)          # [n, 1, 576] bf16
+        else:
+            rows = kv_layer[local_idx].to(k.dtype)
+        rows = rows.view(rows.shape[0], 1, -1)
+        cache_k_nope, cache_k_rope = rows[..., : layer.v_head_dim], rows[..., layer.v_head_dim :]
+        gathered = all_gather_kv_cache_for_dcp(
+            cache_k_nope, cache_k_rope, torch.tensor(prefix_lens), prefix_starts_cpu=torch.zeros(len(prefix_lens), dtype=torch.int64)
+        )
+        gathered = gathered.view(-1, gathered.shape[-1])
+        new = torch.cat([k.view(k.shape[0], -1), k_rope.view(k_rope.shape[0], -1)], dim=-1).to(gathered.dtype)
+        parts, p0, e0 = [], 0, 0
+        for pl, el in zip(prefix_lens, extend_lens):
+            parts.append(gathered[p0 : p0 + pl])
+            parts.append(new[e0 : e0 + el])
+            p0 += pl
+            e0 += el
+        return torch.cat(parts, dim=0).unsqueeze(1)
+
+    def _forward_flashmla_kv_dcp(
+        self,
+        q_all: torch.Tensor,
+        kv_cache: torch.Tensor,
+        v_head_dim: int,
+        sm_scale: float,
+        layer,
+        page_table_1: torch.Tensor,
+        cache_seqlens: torch.Tensor,
+    ):
+        """Numinous DCP decode: FlashMLA fp8 decode over this rank's owned selected slots; returns (o, lse)."""
+        from sgl_kernel.flash_mla import flash_mla_with_kvcache
+
+        q_all = q_all.view(-1, 1, q_all.shape[-2], layer.head_dim)
+        num_q_heads = q_all.shape[2]
+        target_q_heads = self.flashmla_kv_num_q_heads
+        if target_q_heads != num_q_heads:
+            q_input = q_all.new_zeros(q_all.shape[0], q_all.shape[1], target_q_heads, q_all.shape[3])
+            q_input[:, :, :num_q_heads, :] = q_all
+        else:
+            q_input = q_all
+        kv_cache = kv_cache.view(-1, self.real_page_size, 1, self.kv_cache_dim)
+        assert self.real_page_size == 64, "only page size 64 is supported"
+        if not self.dsa_kv_cache_store_fp8:
+            kv_cache = quantize_k_cache(kv_cache)
+        indices = page_table_1.unsqueeze(1)
+        assert indices.shape[-1] == self.dsa_index_topk
+        # the tile scheduler must see this rank's valid counts, not the global topk-clipped lengths
+        flashmla_metadata = self._compute_flashmla_metadata(cache_seqlens, 1)
+        o, lse = flash_mla_with_kvcache(
+            q=q_input,
+            k_cache=kv_cache,
+            cache_seqlens=cache_seqlens,
+            head_dim_v=v_head_dim,
+            tile_scheduler_metadata=flashmla_metadata.flashmla_metadata,
+            num_splits=flashmla_metadata.num_splits,
+            softmax_scale=sm_scale,
+            indices=indices,
+            block_table=torch.empty((q_all.shape[0], 0), dtype=torch.int32, device=q_all.device),
+            is_fp8_kvcache=True,
+        )
+        if target_q_heads != num_q_heads:
+            o = o[:, :, :num_q_heads, :]
+            lse = lse[:, :num_q_heads]
+        o = o.view(-1, num_q_heads, v_head_dim)
+        lse = lse.reshape(-1, num_q_heads).float()
+        # rows this rank holds nothing for: neutral partials so the merge ignores them
+        empty = (cache_seqlens == 0).view(-1, 1)
+        o = torch.where(empty.unsqueeze(-1), torch.zeros_like(o), o)
+        lse = torch.where(empty, torch.full_like(lse, float("-inf")), lse)
+        return o, lse
+
     def _forward_standard_mha(
         self,
         q: torch.Tensor,
