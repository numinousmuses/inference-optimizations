From 9d22825cca62bae2ca6c79372a9c4c2ec48e8c38 Mon Sep 17 00:00:00 2001
From: numinousmuses <103385201+numinousmuses@users.noreply.github.com>
Date: Mon, 21 Sep 2026 23:20:38 +0000
Subject: [PATCH] dsa: decode context parallel v1. KV sharded by the owner rule
 (existing write kernels), indexer key cache replicated over the virtual slot
 span, decode through FlashMLA fp8 decode on this rank's owned selected slots
 returning (o, lse) for the existing cross-rank merge, extend over the
 group-gathered request-contiguous prefix, draft DSA pool keeps 64-token index
 pages over its virtual span. Forces flashmla_sparse/flashmla_kv under
 --dcp-size > 1.

---
 python/sglang/srt/arg_groups/overrides.py     |   8 ++
 .../srt/layers/attention/dsa/dcp_topk.py      |   9 ++
 .../srt/layers/attention/dsa_backend.py       | 109 +++++++++++++++++-
 .../srt/mem_cache/kv_cache_configurator.py    |  54 ++++++++-
 .../attention_forward_methods/forward_mla.py  |   3 +-
 test/numinous/test_dcp_topk.py                |   8 ++
 6 files changed, 182 insertions(+), 9 deletions(-)

diff --git a/python/sglang/srt/arg_groups/overrides.py b/python/sglang/srt/arg_groups/overrides.py
index 53898da0c..da24c395e 100644
--- a/python/sglang/srt/arg_groups/overrides.py
+++ b/python/sglang/srt/arg_groups/overrides.py
@@ -1737,6 +1737,14 @@ def _dsa_split_backend_resolution(view: Any) -> dict:
         if not user_set_decode:
             declared["dsa_decode_backend"] = "trtllm" if major >= 10 else "fa3"
 
+    if getattr(view, "dcp_size", 1) and view.dcp_size > 1:
+        # Numinous DCP on the DSA backend: decode goes through FlashMLA's fp8 decode kernel (returns the LSE the
+        # cross-rank merge needs) and prefill through the bf16 sparse kernel over the group-gathered prefix.
+        if kv_cache_dtype != "fp8_e4m3":
+            raise ValueError("--dcp-size > 1 on the DSA backend requires --kv-cache-dtype fp8_e4m3")
+        declared["dsa_prefill_backend"] = "flashmla_sparse"
+        declared["dsa_decode_backend"] = "flashmla_kv"
+        logger.warning("DCP on DSA: forcing dsa_prefill_backend=flashmla_sparse, dsa_decode_backend=flashmla_kv")
     prefill = declared.get("dsa_prefill_backend", view.dsa_prefill_backend)
     decode = declared.get("dsa_decode_backend", view.dsa_decode_backend)
     _check_tilelang_dsa_fp8_kv(kv_cache_dtype, prefill, decode, hip=is_hip())
diff --git a/python/sglang/srt/layers/attention/dsa/dcp_topk.py b/python/sglang/srt/layers/attention/dsa/dcp_topk.py
index 3561c3c82..aa42758de 100644
--- a/python/sglang/srt/layers/attention/dsa/dcp_topk.py
+++ b/python/sglang/srt/layers/attention/dsa/dcp_topk.py
@@ -78,3 +78,12 @@ def select_dcp(scores_full: torch.Tensor, k: int, dcp_size: int) -> list[torch.T
     gathered_s, gathered_p = torch.cat(cands_s, dim=-1), torch.cat(cands_p, dim=-1)  # the all-gather
     _, top_p = merge_topk(gathered_s, gathered_p, k)
     return [compact_owned(global_to_local_owned(top_p, dcp_size, r)) for r in range(dcp_size)]
+
+
+def owned_local_slots(slots: torch.Tensor, dcp_size: int, dcp_rank: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Kernel-facing form of the owner rule on selected KV slots: [rows, k] virtual slots (with -1 padding) ->
+    ([rows, k] int32 local slots compacted to the front with -1 after, [rows] int32 valid counts)."""
+    local = global_to_local_owned(slots.to(torch.int64), dcp_size, dcp_rank)
+    local = compact_owned(local)
+    counts = (local >= 0).sum(dim=-1).to(torch.int32)
+    return local.to(torch.int32), counts
